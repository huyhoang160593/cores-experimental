+	// spruce: core option mupen64plus-BufferSwapMode (default 0 = bsOnVerticalInterrupt, the old fixed value)
+	config.frameBufferEmulation.bufferSwapMode = BufferSwapModeOpt;
 
 #ifdef HAVE_OPENGLES2
 	config.generalEmulation.enableFragmentDepthWrite = 0;
